# PostgreSQL connection string. On Vercel, add a Neon/Postgres database from the
# Storage tab (it sets DATABASE_URL), or paste any hosted PostgreSQL URL.
DATABASE_URL=postgresql://user:password@host:5432/scamshield

# Use a unique random secret of at least 32 characters. Never commit the real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional comma-separated list of additional allowed browser origins.
FRONTEND_URL=

# Address of the FastAPI ML service. Locally this is http://127.0.0.1:8000;
# on Vercel it is the URL of the separate ml-service deployment.
ML_SERVICE_URL=http://127.0.0.1:8000

# Optional shared secret between Express and the ML service. Set the same value
# on both deployments so the public ML URL only answers the API.
ML_SERVICE_TOKEN=

# Optional timeout (ms) for ML requests; allows for serverless cold starts.
ML_SERVICE_TIMEOUT_MS=25000

# The default is ml-service/models when the service runs from this repository.
MODEL_DIR=
NODE_ENV=development
