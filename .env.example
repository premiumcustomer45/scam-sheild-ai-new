# Replit provides DATABASE_URL for the managed PostgreSQL instance.
# For local development, set it to a PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:5432/scamshield

# Use a unique random secret of at least 32 characters. Store the real value in Replit Secrets.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional comma-separated list of additional allowed browser origins.
FRONTEND_URL=

# Keep FastAPI private; Express uses this address for model inference.
ML_SERVICE_URL=http://127.0.0.1:8000

# The default is ml-service/models when the service runs from this repository.
MODEL_DIR=
NODE_ENV=development
